  },
  {
    "id": "lh_idiom_ostinato_in_an_irregular_metre",
    "category": "composer_hand_idiom",
    "hand": "lh",
    "name": "Ostinato in an irregular metre",
    "description": "a short figure repeated exactly under a changing metre, the Bulgarian rhythms of 5/8, 7/8 and 9/8 grouped 2+2+3. `C2e G2e C2e G2e C2e`",
