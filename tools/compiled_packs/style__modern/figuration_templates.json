    "id": "lh_idiom_struck_dissonant_blocks",
    "category": "composer_hand_idiom",
    "hand": "lh",
    "name": "Struck dissonant blocks",
    "description": "a chord containing a second or a seventh, played hard and not resolved. The seconds are the sound. `[C3,D3,G3]e [C3,D3,G3]e`",
