  {
    "id": "device_strophic_repetition_without_development",
    "category": "composer_device",
    "section": "Structural devices",
    "name": "Strophic repetition without development",
    "description": "the same music three times, with tiny changes or none. There is no development section because there is no argument.",
    "source_file": "satie/satie-devices.md",
    "grounding": "hard_corroborated"
  },
  {
    "id": "device_sectional_blocks_that_simply_stop",
    "category": "composer_device",
    "section": "Structural devices",
    "name": "Sectional blocks that simply stop",
    "description": "a section ends and another begins with no transition and no modulation joining them.",
    "source_file": "satie/satie-devices.md",
    "grounding": "hard_corroborated"
  },
  {
    "id": "device_the_three_piece_set",
    "category": "composer_device",
    "section": "Structural devices",
    "name": "The three-piece set",
    "description": "Gymnop\u00e9dies, Gnossiennes: variations on one mood rather than one theme, each piece nearly the same as the last.",
    "source_file": "satie/satie-devices.md",
    "grounding": "hard_corroborated"
  },
  {
    "id": "device_no_climax",
    "category": "composer_device",
    "section": "Structural devices",
    "name": "No climax.",
    "description": "The dynamic level barely moves. The piece has no highest point, which is why it feels suspended rather than shaped.",
    "source_file": "satie/satie-devices.md",
    "grounding": "hard_corroborated"
  },
  {
    "id": "device_absence_of_a_double_bar_s_worth_of_preparation",
    "category": "composer_device",
    "section": "Structural devices",
    "name": "Absence of a double bar's worth of preparation",
    "description": "no retransition, no dominant build. Arrivals are not prepared.",
    "source_file": "satie/satie-devices.md",
    "grounding": "hard_corroborated"
  },
  {
    "id": "device_parallel_seventh_and_ninth_chords",
    "category": "composer_device",
    "section": "Harmonic devices",
    "name": "Parallel seventh and ninth chords",
    "description": "the whole chord moving in parallel, which the period forbade. The Gymnop\u00e9dies open on a major seventh.",
    "source_file": "satie/satie-devices.md",
    "grounding": "hard_corroborated"
  },
  {
    "id": "device_unresolved_sevenths",
    "category": "composer_device",
    "section": "Harmonic devices",
    "name": "Unresolved sevenths",
    "description": "a seventh chord that simply moves to another seventh chord. Nothing resolves in the textbook sense.",
    "source_file": "satie/satie-devices.md",
    "grounding": "hard_corroborated"
  },
  {
