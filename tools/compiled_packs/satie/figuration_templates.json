[
  {
    "id": "lh_idiom_the_gymnop_die_bass_and_chord",
    "category": "composer_hand_idiom",
    "hand": "lh",
    "name": "The Gymnop\u00e9die bass-and-chord",
    "description": "a single low bass note on beat 1, a mid-register chord on beat 2, nothing on beat 3. In 3/4 forever. `G2h. // rest_q [B3,D4,F#4]q rest_q` The rest on three is the whole gesture. Filling it destroys the piece.",
    "shorthand": "G2h. // rest_q [B3,D4,F#4]q rest_q",
    "events": 5,
    "register": [
      43,
      66
    ],
    "span_semitones": 23,
    "source_file": "satie/satie-lh-vocabulary.md",
    "grounding": "hard_corroborated"
  },
  {
    "id": "lh_idiom_bare_octaves_in_the_low_register",
    "category": "composer_hand_idiom",
    "hand": "lh",
    "name": "Bare octaves in the low register",
    "description": "the bass alone, doubled at the octave, under a slow melody. Used for the Gnossiennes' opening. `[D2,D3]w`",
    "shorthand": "[D2,D3]w",
    "events": 1,
    "register": [
      38,
      50
    ],
    "span_semitones": 12,
    "source_file": "satie/satie-lh-vocabulary.md",
    "grounding": "hard_corroborated"
  },
  {
    "id": "lh_idiom_the_unchanging_ostinato",
    "category": "composer_hand_idiom",
    "hand": "lh",
    "name": "The unchanging ostinato",
    "description": "one figure repeated exactly while the right hand moves through unrelated harmony. Change the ostinato only at a section.",
    "source_file": "satie/satie-lh-vocabulary.md",
    "grounding": "hard_corroborated"
  },
  {
    "id": "lh_idiom_pedal_point_under_everything",
    "category": "composer_hand_idiom",
    "hand": "lh",
    "name": "Pedal point under everything",
    "description": "a held bass for eight or sixteen bars while the upper chords shift over it. 18% of his bars.",
    "source_file": "satie/satie-lh-vocabulary.md",
    "grounding": "hard_corroborated"
  },
  {
    "id": "lh_idiom_slow_walking_bass_in_even_quarters",
    "category": "composer_hand_idiom",
    "hand": "lh",
    "name": "Slow walking bass in even quarters",
    "description": "the cabaret inheritance, used in the more popular pieces. Even, unhurried, never syncopated.",
    "source_file": "satie/satie-lh-vocabulary.md",
    "grounding": "hard_corroborated"
  },
  {
    "id": "lh_idiom_silence",
    "category": "composer_hand_idiom",
    "hand": "lh",
    "name": "Silence",
    "description": "the left hand stops for a bar or a phrase. 16% of his bars. In any other composer this is a gap; here it is a texture, and it is why the returning bass has weight.",
    "source_file": "satie/satie-lh-vocabulary.md",
    "grounding": "hard_corroborated"
  },
