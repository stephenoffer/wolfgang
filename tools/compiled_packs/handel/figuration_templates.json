[
  {
    "id": "lh_idiom_steady_continuo_quarters",
    "category": "composer_hand_idiom",
    "hand": "lh",
    "name": "Steady continuo quarters",
    "description": "`D2q A2q D3q A2q`. Root and fifth alternating, one chord per bar or per half bar. The default, and it should sound unhurried.",
    "shorthand": "D2q A2q D3q A2q",
    "events": 4,
    "register": [
      38,
      50
    ],
    "span_semitones": 12,
    "source_file": "handel/handel-lh-vocabulary.md",
    "grounding": "hard_corroborated"
  },
  {
    "id": "lh_idiom_walking_eighths",
    "category": "composer_hand_idiom",
    "hand": "lh",
    "name": "Walking eighths",
    "description": "`D2e E2e F#2e G2e A2e B2e C#3e D3e`. Drives an aria or a fast movement; mostly stepwise with an occasional leap to the next harmony.",
    "shorthand": "D2e E2e F#2e G2e A2e B2e C#3e D3e",
    "events": 8,
    "register": [
      38,
      50
    ],
    "span_semitones": 12,
    "source_file": "handel/handel-lh-vocabulary.md",
    "grounding": "hard_corroborated"
  },
  {
    "id": "lh_idiom_repeated_notes_on_one_pitch",
    "category": "composer_hand_idiom",
    "hand": "lh",
    "name": "Repeated notes on one pitch",
    "description": "`D2e \u00d78`. Insistent, and used under a sequence where the harmony above is doing the moving.",
    "shorthand": "D2e \u00d78",
    "events": 2,
