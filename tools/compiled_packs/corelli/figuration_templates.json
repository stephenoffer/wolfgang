    "grounding": "hard_corroborated"
  },
  {
    "id": "device_even_harmonic_rhythm",
    "category": "composer_device",
    "section": "Harmonic devices",
    "name": "Even harmonic rhythm",
    "description": "one chord per beat or per bar, held for a whole section. Irregular harmonic rhythm sounds later than this style.",
    "source_file": "corelli/corelli-devices.md",
