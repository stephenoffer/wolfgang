    "register": [
      39,
      55
    ],
    "span_semitones": 16,
    "source_file": "mussorgsky/mussorgsky-lh-vocabulary.md",
    "grounding": "hard_corroborated"
  },
  {
    "id": "lh_idiom_block_chords_on_the_beat_thick_and_low",
    "category": "composer_hand_idiom",
    "hand": "lh",
    "name": "Block chords on the beat, thick and low",
    "description": "five and six notes struck together in the bass register. Not spread, not rolled. `[C2,G2,C3,E-3,G3]h [C2,G2,C3,E-3,G3]h`",
