  },
  {
    "id": "lh_idiom_the_pedal_bass_with_chords_above",
    "category": "composer_hand_idiom",
    "hand": "lh",
    "name": "The pedal bass with chords above",
    "description": "a low held note while the harmony moves over it. Used for the ominous pictures.",
    "source_file": "mussorgsky/mussorgsky-lh-vocabulary.md",
    "grounding": "hard_corroborated"
  },
  {
