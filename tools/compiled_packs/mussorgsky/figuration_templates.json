  },
  {
    "id": "lh_idiom_off_beat_chordal_stabs",
    "category": "composer_hand_idiom",
    "hand": "lh",
    "name": "Off-beat chordal stabs",
    "description": "a rest on the beat and the chord after it, giving the lurching gait of *Byd\u0142o* and *Gnomus*. 28% of his bars. `rest_e [C3,E-3,G3]e rest_e [C3,E-3,G3]e`",
    "shorthand": "rest_e [C3,E-3,G3]e rest_e [C3,E-3,G3]e",
    "events": 4,
    "register": [
      48,
      55
    ],
    "span_semitones": 7,
    "source_file": "mussorgsky/mussorgsky-lh-vocabulary.md",
    "grounding": "hard_corroborated"
  },
  {
    "id": "lh_idiom_tremolo_or_repeated_chord_under_a_melody",
    "category": "composer_hand_idiom",
    "hand": "lh",
    "name": "Tremolo or repeated chord under a melody",
    "description": "a chord repeated in even values for tension, usually growing.",
