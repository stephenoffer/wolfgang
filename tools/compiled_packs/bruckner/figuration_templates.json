[
  {
    "id": "lh_idiom_the_long_pedal_point",
    "category": "composer_hand_idiom",
    "hand": "lh",
    "name": "The long pedal point",
    "description": "a bass note held for eight, sixteen or thirty-two bars while everything above it changes. Forty-one percent of the armed bars, and the single most Brucknerian device. `C2w | C2w | C2w | C2w`",
    "shorthand": "C2w | C2w | C2w | C2w",
    "events": 7,
    "register": [
      36,
      36
    ],
    "span_semitones": 0,
    "source_file": "bruckner/bruckner-lh-vocabulary.md",
    "grounding": "hard_corroborated"
  },
  {
    "id": "lh_idiom_the_bass_as_melody",
    "category": "composer_hand_idiom",
    "hand": "lh",
    "name": "The bass as melody",
    "description": "the lowest voice carrying the tune while the upper parts sustain. A third of his bars. This is the organ pedal division playing a chorale.",
    "source_file": "bruckner/bruckner-lh-vocabulary.md",
    "grounding": "hard_corroborated"
  },
  {
    "id": "lh_idiom_full_block_chords_organ_registration_thick",
    "category": "composer_hand_idiom",
    "hand": "lh",
    "name": "Full block chords, organ-registration thick",
    "description": "five to eight notes, struck and held, changing on the bar rather than within it.",
    "source_file": "bruckner/bruckner-lh-vocabulary.md",
    "grounding": "hard_corroborated"
  },
  {
    "id": "lh_idiom_bare_octaves_in_unison",
    "category": "composer_hand_idiom",
    "hand": "lh",
    "name": "Bare octaves in unison",
    "description": "the whole texture reduced to one line at the octave, for a theme's first statement. The contrast with the block chords is the drama.",
    "source_file": "bruckner/bruckner-lh-vocabulary.md",
    "grounding": "hard_corroborated"
  },
  {
    "id": "lh_idiom_tremolo_string_carpet",
    "category": "composer_hand_idiom",
    "hand": "lh",
    "name": "Tremolo string carpet",
    "description": "a sustained shimmer under a brass melody. In a piano reduction this is a repeated chord.",
    "source_file": "bruckner/bruckner-lh-vocabulary.md",
    "grounding": "hard_corroborated"
  },
  {
    "id": "lh_idiom_total_silence",
    "category": "composer_hand_idiom",
    "hand": "lh",
    "name": "Total silence",
    "description": "the general pause. Bruckner stops the entire orchestra before a new paragraph, and the silence is a structural device, not a rest.",
    "source_file": "bruckner/bruckner-lh-vocabulary.md",
    "grounding": "hard_corroborated"
  },
