    "category": "composer_device",
    "section": "Structural devices",
    "name": "The general pause",
    "description": "everything stops for a full bar or more before a new paragraph begins. Structural punctuation, and it must not be filled.",
    "source_file": "bruckner/bruckner-devices.md",
    "grounding": "hard_corroborated"
  },
  {
